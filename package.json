{
  "name": "junction-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "dev": "pnpm --filter example-react dev",
    "dev:docs": "vitepress dev docs",
    "format": "prettier --write .",
    "lint:prettier": "prettier --check .",
    "lint:typescript": "tsc --noEmit && pnpm -r lint:typescript",
    "lint:eslint": "eslint .",
    "lint:docs": "tsc --noEmit -p docs/tsconfig.json",
    "test:lint": "node scripts/verify-lint-rules.mjs && node scripts/verify-no-any.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:examples": "pnpm build && playwright test -c examples/playwright.config.ts",
    "test:package": "node scripts/verify-packages.mjs",
    "test:mutation": "node scripts/mutate.mjs",
    "build:docs": "vitepress build docs && node scripts/build-demo.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify:snippets": "node scripts/verify-snippets.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "check": "pnpm build && pnpm lint:typescript && pnpm lint:eslint && pnpm test:lint && pnpm lint:prettier && pnpm test:unit",
    "check:release": "pnpm check && pnpm lint:docs && pnpm build:docs && pnpm verify:docs && pnpm verify:snippets && pnpm test:package && pnpm verify:release && pnpm -r --if-present --filter './examples/*' build && pnpm test:mutation"
  },
  "devDependencies": {
    "@appsflyer-sdk/js-core-plugin": "7.0.15",
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.63.0",
    "@priemskiyyy/junction": "workspace:*",
    "@priemskiyyy/junction-react": "workspace:*",
    "@swmansion/react-native-detour": "2.3.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "expo-linking": "57.0.11",
    "expo-notifications": "57.0.21",
    "expo-quick-actions": "6.0.2",
    "fast-check": "4.10.2",
    "jsdom": "27.4.0",
    "prettier": "3.9.6",
    "publint": "0.3.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.3",
    "react-native-adjust": "5.8.0",
    "react-native-appsflyer": "7.0.2",
    "react-native-appsflyer-v6": "npm:react-native-appsflyer@6.18.0",
    "react-native-branch": "7.0.0",
    "tsdown": "0.22.14",
    "typescript": "5.8.3",
    "typescript-eslint": "8.70.0",
    "vitepress": "1.6.4",
    "vitest": "4.1.10",
    "zod": "4.1.12"
  }
}
