{
  "name": "@priemskiyyy/junction-react",
  "version": "0.1.0",
  "description": "React and React Native bindings for Junction: a provider, a hook that makes a component the consumer of an intent, and hooks that observe the inbox and the sources without starting or claiming anything.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/junction.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/junction/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../.. --project react"
  },
  "peerDependencies": {
    "@priemskiyyy/junction": ">=0.1.0 <0.2",
    "react": ">=19.2.0 <20"
  },
  "devDependencies": {
    "@priemskiyyy/junction": "workspace:*"
  },
  "keywords": [
    "react",
    "react-native",
    "hooks",
    "deep-linking",
    "intents",
    "typescript",
    "junction"
  ],
  "homepage": "https://priemskiyyy.github.io/junction/"
}
