{
  "name": "@priemskiyyy/junction-silo",
  "version": "0.1.0",
  "description": "Silo storage for Junction: the persistent inbox kept in one Silo value, over the value handle you inject.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/junction.git",
    "directory": "packages/integrations/silo"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/junction/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../../.. --project silo"
  },
  "peerDependencies": {
    "@priemskiyyy/junction": ">=0.1.0 <0.2"
  },
  "devDependencies": {
    "@priemskiyyy/junction": "workspace:*"
  },
  "keywords": [
    "silo",
    "persistence",
    "storage",
    "typescript",
    "junction",
    "deep-linking"
  ],
  "homepage": "https://priemskiyyy.github.io/junction/"
}
